{
  "rules": {
    ".read": false,
    ".write": false,
    "gallery": {
      "meta": {
        ".read": true,
        "$photoId": {
          ".write": "auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1'",
          ".validate": "newData.hasChildren(['caption', 'createdAt', 'width', 'height', 'bytes'])",
          "caption": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "width": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1024" },
          "height": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1024" },
          "bytes": { ".validate": "newData.isNumber() && newData.val() <= 140000" },
          "$other": { ".validate": false }
        }
      },
      "thumbs": {
        "$photoId": {
          ".read": true,
          ".write": "auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1'",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 20000"
        }
      },
      "full": {
        "$photoId": {
          ".read": true,
          ".write": "auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1'",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 120000"
        }
      }
    },
    "qna": {
      ".read": true,
      "$questionId": {
        ".write": "(auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1') || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['question', 'createdAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "question": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 500" },
        "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
        "answer": { ".validate": "auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1' && newData.isString() && newData.val().length <= 2000" },
        "answeredAt": { ".validate": "auth != null && auth.uid === 'x2PfMwkpbmQQDudDhWH5lyKkkbh1' && newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
